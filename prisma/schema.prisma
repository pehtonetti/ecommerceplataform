generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model address {
  id           String   @id
  userId       String
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  country      String   @default("Brasil")
  isDefault    Boolean  @default(false)
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([userId], map: "Address_userId_idx")
}

model behaviorallog {
  id        String   @id
  userId    String?
  action    String
  details   String?  @db.LongText
  ip        String?
  source    String?
  createdAt DateTime @default(now())

  @@index([action], map: "BehavioralLog_action_idx")
  @@index([userId], map: "BehavioralLog_userId_idx")
}

model carrier {
  id              String   @id
  name            String
  code            String?
  isActive        Boolean  @default(true)
  calculateApiUrl String?
  apiKey          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model cart {
  id        String   @id
  userId    String?  @unique(map: "Cart_userId_key")
  sessionId String?  @unique(map: "Cart_sessionId_key")
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([sessionId], map: "Cart_sessionId_idx")
}

model cartitem {
  id               String  @id
  cartId           String
  productId        String
  quantity         Int
  selectedColor    String?
  selectedCapacity String?

  @@index([cartId], map: "CartItem_cartId_idx")
  @@index([productId], map: "CartItem_productId_idx")
}

model category {
  id          String   @id
  name        String   @unique(map: "Category_name_key")
  slug        String   @unique(map: "Category_slug_key")
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model coupon {
  id                String    @id
  code              String    @unique(map: "Coupon_code_key")
  description       String?
  discountType      String
  discountValue     Int
  minPurchaseAmount Int?
  maxDiscountAmount Int?
  maxUses           Int?
  usesCount         Int       @default(0)
  validFrom         DateTime  @default(now())
  validUntil        DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@index([code], map: "Coupon_code_idx")
}

model emailtemplate {
  id        String   @id
  name      String   @unique(map: "EmailTemplate_name_key")
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model fiscalconfig {
  id              String   @id
  certificatePath String?
  certificatePass String?
  environment     String   @default("homologation")
  cnpj            String?
  companyName     String?
  ie              String?
  updatedAt       DateTime
}

model invoice {
  id           String    @id
  orderId      String
  number       String?
  series       String?
  accessKey    String?
  xmlUrl       String?
  pdfUrl       String?
  status       String    @default("draft")
  issuedAt     DateTime  @default(now())
  authorizedAt DateTime?

  @@index([accessKey], map: "Invoice_accessKey_idx")
  @@index([orderId], map: "Invoice_orderId_idx")
}

model loyaltytransaction {
  id          String   @id
  userId      String
  points      Int
  type        String
  description String
  orderId     String?
  createdAt   DateTime @default(now())

  @@index([userId], map: "LoyaltyTransaction_userId_idx")
}

model order {
  id                  String    @id
  userId              String
  addressId           String?
  shippingMethod      String?
  shippingCost        Int?
  shippingDays        Int?
  trackingCode        String?
  couponId            String?
  discountAmount      Int       @default(0)
  loyaltyPointsEarned Int       @default(0)
  loyaltyPointsUsed   Int       @default(0)
  subtotal            Int
  taxAmount           Int       @default(0)
  total               Int
  status              String    @default("pending")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  pixExpiresAt        DateTime?
  pixPaidAt           DateTime?
  pixQRCode           String?   @db.Text
  pixTransactionId    String?

  @@index([addressId], map: "Order_addressId_idx")
  @@index([couponId], map: "Order_couponId_idx")
  @@index([userId], map: "Order_userId_idx")
}

model orderitem {
  id        String @id
  orderId   String
  productId String
  quantity  Int
  price     Int

  @@index([orderId], map: "OrderItem_orderId_idx")
  @@index([productId], map: "OrderItem_productId_idx")
}

model product {
  id          String   @id
  name        String
  description String   @db.Text
  price       Int
  currency    String   @default("BRL")
  stock       Int
  imageUrl    String
  videoUrl    String?
  category    String
  active      Boolean  @default(true)
  colors      String?  @db.LongText
  capacities  String?  @db.LongText
  weight      Int?
  length      Int?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model productimage {
  id        String   @id
  productId String
  url       String
  alt       String?
  createdAt DateTime @default(now())

  @@index([productId], map: "ProductImage_productId_idx")
}

model productview {
  id        String   @id
  productId String
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt], map: "ProductView_createdAt_idx")
  @@index([productId], map: "ProductView_productId_idx")
  @@index([userId], map: "ProductView_userId_idx")
}

model review {
  id        String   @id
  productId String
  userId    String
  rating    Int
  title     String?
  comment   String   @db.Text
  videoUrl  String?
  verified  Boolean  @default(false)
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([productId], map: "Review_productId_idx")
  @@index([userId], map: "Review_userId_idx")
}

model storeconfig {
  id              String   @id
  storeName       String
  homeLayout      String?  @db.LongText
  originZipCode   String?
  whatsappNumber  String?
  whatsappMessage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  merchantCity    String?  @default("Sao Paulo")
  pixKey          String?
}

model supportticket {
  id         String   @id
  userId     String?
  subject    String
  message    String   @db.Text
  status     String   @default("open")
  priority   String   @default("medium")
  guestEmail String?
  guestName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([userId], map: "SupportTicket_userId_idx")
}

model user {
  id            String   @id
  name          String
  email         String   @unique(map: "User_email_key")
  document      String?
  password      String
  role          String   @default("customer")
  isGuest       Boolean  @default(false)
  loyaltyPoints Int      @default(0)
  locale        String?  @default("pt-BR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model wishlistitem {
  id        String   @id
  userId    String
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId], map: "WishlistItem_userId_productId_key")
  @@index([productId], map: "WishlistItem_productId_idx")
  @@index([userId], map: "WishlistItem_userId_idx")
}
