generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── MULTI-TENANCY: Store model ───────────────────────────────────────────────
model Store {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  customDomain    String?  @unique
  plan            String   @default("free") // free | starter | pro
  ownerId         String
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String?  @default("#6366f1")
  theme           String?  @default("minimal")
  currency        String   @default("BRL")
  locale          String   @default("pt-BR")
  originZipCode   String?
  whatsappNumber  String?
  pixKey          String?
  googleAnalyticsId String?
  facebookPixelId   String?
  homeLayout      String?  @db.LongText
  merchantCity    String?  @default("Sao Paulo")
  whatsappMessage String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation(fields: [ownerId], references: [id])

  products        Product[]
  orders          Order[]
  categories      Category[]
  banners         Banner[]
  coupons         Coupon[]
  emailTemplates  EmailTemplate[]
  carriers        Carrier[]
  supportTickets  SupportTicket[]
  apiKeys         ApiKey[]
  subscriptions   Subscription[]
  posts           Post[]

  @@map("store")
}

model ApiKey {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  key       String   @unique
  name      String   @default("Default Key")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastUsed  DateTime?

  @@index([storeId])
  @@map("apikey")
}

model Subscription {
  id               String   @id @default(uuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId           String
  status           String   @default("active") // active | canceled | past_due
  stripeId         String?  @unique
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([storeId])
  @@map("subscription")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  country      String   @default("Brasil")
  isDefault    Boolean  @default(false)
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([userId], map: "Address_userId_idx")
  @@map("address")
}

model BehavioralLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?  @db.LongText
  ip        String?
  source    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action], map: "BehavioralLog_action_idx")
  @@index([userId], map: "BehavioralLog_userId_idx")
  @@map("behaviorallog")
}

model Carrier {
  id              String   @id @default(uuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  code            String?
  isActive        Boolean  @default(true)
  calculateApiUrl String?
  apiKey          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@map("carrier")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique(map: "Cart_userId_key")
  sessionId String?    @unique(map: "Cart_sessionId_key")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "Cart_sessionId_idx")
  @@map("cart")
}

model CartItem {
  id               String  @id @default(uuid())
  cartId           String
  productId        String
  quantity         Int
  selectedColor    String?
  selectedCapacity String?
  cart             Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [productId], references: [id])

  @@index([cartId], map: "CartItem_cartId_idx")
  @@index([productId], map: "CartItem_productId_idx")
  @@map("cartitem")
}

model Category {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("category")
}

model Coupon {
  id                String    @id @default(uuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code              String
  description       String?
  discountType      String
  discountValue     Int
  minPurchaseAmount Int?
  maxDiscountAmount Int?
  maxUses           Int?
  usesCount         Int       @default(0)
  validFrom         DateTime  @default(now())
  validUntil        DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
  @@map("coupon")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
  @@map("emailtemplate")
}

model FiscalConfig {
  id              String   @id @default(uuid())
  certificatePath String?
  certificatePass String?
  environment     String   @default("homologation")
  cnpj            String?
  companyName     String?
  ie              String?
  updatedAt       DateTime @updatedAt

  @@map("fiscalconfig")
}

model Invoice {
  id           String    @id @default(uuid())
  orderId      String
  number       String?
  series       String?
  accessKey    String?
  xmlUrl       String?
  pdfUrl       String?
  status       String    @default("draft")
  issuedAt     DateTime  @default(now())
  authorizedAt DateTime?
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([accessKey], map: "Invoice_accessKey_idx")
  @@index([orderId], map: "Invoice_orderId_idx")
  @@map("invoice")
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  userId      String
  points      Int
  type        String
  description String
  orderId     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "LoyaltyTransaction_userId_idx")
  @@map("loyaltytransaction")
}

model Order {
  id                  String      @id @default(uuid())
  storeId             String
  store               Store       @relation(fields: [storeId], references: [id])
  userId              String
  addressId           String?
  address             Address?    @relation(fields: [addressId], references: [id])
  shippingMethod      String?
  shippingCost        Int?
  shippingDays        Int?
  trackingCode        String?
  couponId            String?
  discountAmount      Int         @default(0)
  loyaltyPointsEarned Int         @default(0)
  loyaltyPointsUsed   Int         @default(0)
  subtotal            Int
  taxAmount           Int         @default(0)
  total               Int
  status              String      @default("pending")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  pixExpiresAt        DateTime?
  pixPaidAt           DateTime?
  pixQRCode           String?     @db.Text
  pixTransactionId    String?
  items               OrderItem[]
  invoices            Invoice[]
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([addressId], map: "Order_addressId_idx")
  @@index([couponId], map: "Order_couponId_idx")
  @@index([userId], map: "Order_userId_idx")
  @@map("order")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_idx")
  @@index([productId], map: "OrderItem_productId_idx")
  @@map("orderitem")
}

model Product {
  id           String         @id @default(uuid())
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  description  String         @db.Text
  price        Int
  currency     String         @default("BRL")
  stock        Int
  imageUrl     String
  videoUrl     String?
  category     String
  active       Boolean        @default(true)
  colors       String?        @db.LongText
  capacities   String?        @db.LongText
  weight       Int?
  length       Int?
  width        Int?
  height       Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProductImage[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlistItems WishlistItem[]
  productViews ProductView[]
  inventoryBatches InventoryBatch[]

  @@index([storeId])
  @@map("product")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  alt       String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "ProductImage_productId_idx")
  @@map("productimage")
}

model ProductView {
  id        String   @id @default(uuid())
  productId String
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt], map: "ProductView_createdAt_idx")
  @@index([productId], map: "ProductView_productId_idx")
  @@index([userId], map: "ProductView_userId_idx")
  @@map("productview")
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int
  title     String?
  comment   String   @db.Text
  videoUrl  String?
  verified  Boolean  @default(false)
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId], map: "Review_productId_idx")
  @@index([userId], map: "Review_userId_idx")
  @@map("review")
}

// StoreConfig is now superseded by Store model.
// Kept temporarily for backwards-compat during migration.
model StoreConfig {
  id              String   @id @default(uuid())
  storeName       String
  homeLayout      String?  @db.LongText
  originZipCode   String?
  whatsappNumber  String?
  whatsappMessage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  merchantCity    String?  @default("Sao Paulo")
  pixKey          String?

  @@map("storeconfig")
}

model SupportTicket {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId     String?
  subject    String
  message    String   @db.Text
  status     String   @default("open")
  priority   String   @default("medium")
  guestEmail String?
  guestName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([userId], map: "SupportTicket_userId_idx")
  @@map("supportticket")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique(map: "User_email_key")
  phone         String?
  document      String?
  password      String
  avatarUrl     String?  @db.Text
  role          String   @default("customer")
  isGuest       Boolean  @default(false)
  loyaltyPoints Int      @default(0)
  locale        String?  @default("pt-BR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  addresses     Address[]
  behavioralLogs BehavioralLog[]
  cart          Cart?
  loyaltyTransactions LoyaltyTransaction[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  productViews ProductView[]
  supportTickets SupportTicket[]
  stores        Store[]
  sessions      Session[]

  @@map("user")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], map: "WishlistItem_userId_productId_key")
  @@index([productId], map: "WishlistItem_productId_idx")
  @@index([userId], map: "WishlistItem_userId_idx")
  @@map("wishlistitem")
}

model Banner {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String?
  imageUrl    String
  link        String   @default("/")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId, active])
  @@map("banner")
}

model InventoryBatch {
  id              String    @id @default(uuid())
  productId       String
  batchCode       String
  initialQuantity Int
  availableStock  Int
  costPrice       Float?
  supplierName    String?
  expirationDate  DateTime?
  createdAt       DateTime  @default(now())

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("inventorybatch")
}

model Post {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  content   String   @db.LongText
  imageUrl  String?
  author    String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("post")
}

// ─── SECURITY: Tabela de Sessões Seguras ──────────────────────────────────────
// O cookie armazena apenas o token aleatório, nunca o userId diretamente.
// Isso previne session forgery por enumeração de userId.
model Session {
  id        String   @id @default(uuid())
  token     String   @unique  // 256-bit hex token (crypto.randomBytes(32))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

// ─── SECURITY: Log de Auditoria ───────────────────────────────────────────────
// Registra ações críticas (login, logout, mudança de role, delete de dados).
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // ex: LOGIN_SUCCESS, LOGIN_FAIL, PRODUCT_DELETE, etc.
  entity    String?  // ex: Product, Order, User
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("auditlog")
}
